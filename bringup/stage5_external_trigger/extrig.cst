// =============================================================================
// PHOTOACOUSTIC DAQ — TANG NANO 9K — ASIGNACIÓN DE PINES
// =============================================================================
//
// FILOSOFÍA DEL PINMAP
// ────────────────────
// El AD9226 tiene un header de 2 filas con las señales ordenadas columna por
// columna (D0/CLK, D2/D1, D4/D3, …, CTR/D11). Para evitar cruces de cables,
// cada columna del ADC se mapea a 2 pines físicamente adyacentes del header
// IZQUIERDO del Tang Nano 9K. El ADC se monta en su orientación NATURAL
// (sin girar 180°), con un cable plano de 2 vías por columna bajando recto.
//
// Diagrama del ADC (vista superior, tal como se ve el chip):
//
//     Col   3   4   5   6   7   8    9
//     ───────────────────────────────────
//     Sup.  D0  D2  D4  D6  D8  D10  OTR
//     Inf.  CLK D1  D3  D5  D7  D9   D11
//
// Mapeo físico al header IZQUIERDO del Tang Nano 9K (en orden físico):
//
//   Pos  Pin  Señal lógica       Señal ADC   Fase  Notas
//   ─────────────────────────────────────────────────────────────────────
//    5   25   adc_data_raw[0]    D0          F3    [11:0] LSB del bus 12-bit
//    6   26   adc_clk            CLK         F1    Reloj del ADC (27 MHz)
//    7   27   adc_data_raw[2]    D2          F2    Se usa al pasar a 10 bits
//    8   28   adc_data_raw[1]    D1          F3    Solo en 12 bits
//    9   29   adc_data_raw[4]    D4          F1    LSB del modo 8-bit actual
//   10   30   adc_data_raw[3]    D3          F2    Se usa al pasar a 10 bits
//   11   33   adc_data_raw[6]    D6          F1
//   12   34   adc_data_raw[5]    D5          F1
//   13   40   adc_data_raw[8]    D8          F1
//   14   35   adc_data_raw[7]    D7          F1
//   15   41   adc_data_raw[10]   D10         F1
//   16   42   adc_data_raw[9]    D9          F1
//   17   51   adc_otr            OTR         F1*   *declarado, sin uso en HDL
//   18   53   adc_data_raw[11]   D11         F1    MSB
//
// FASES DEL PROYECTO
// ──────────────────
//   F1 (actual)   : 8 bits efectivos → top.v usa adc_data_raw[11:4]
//   F2 (próxima)  : 10 bits efectivos → top.v usa adc_data_raw[11:2]
//   F3 (futura)   : 12 bits completos → top.v usa adc_data_raw[11:0]
//
//   El cableado físico NO cambia entre fases. Solo se edita top.v.
//
// ALIMENTACIÓN
// ────────────
//   Tang Nano 9K (USB) ──► pin 5V  ──► Vcc del módulo AD9226
//                       └► pin GND ──► GND del módulo (común)
//   El módulo AD9226 tiene un LDO interno que genera 3.3V para DRVDD,
//   por eso las salidas digitales oscilan 0–3.3V y son seguras para
//   los IOs del Tang Nano (LVCMOS33, NO 5V-tolerant).
//
// TRIGGER EXTERNO
// ───────────────
//   Pin 77 (IOT37A, Bank 2, LVCMOS33) → trigger_rpi (5 kHz desde Raspberry Pi)
// =============================================================================

// --- SISTEMA BASE ---
IO_LOC "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "sys_rst_n" 4;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- TRIGGERS ---
// Botón S2 físico del Tang Nano 9K.
// Pull-up interno: reposo = HIGH; botón presionado = LOW.
// El flanco activo es LOW→HIGH (liberación del botón).
IO_LOC "trigger_manual" 3;
IO_PORT "trigger_manual" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Tren de pulsos 5 kHz desde Raspberry Pi (GPIO a 3.3V).
// Pull-down: línea en reposo = LOW; pulso activo = HIGH.
// El flanco de subida de cada pulso dispara una ventana de captura.
IO_LOC "trigger_rpi" 77;
IO_PORT "trigger_rpi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- UART TX ---
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- ADC: RELOJ ---
// Pin 26 está físicamente al lado del pin 25 (D0). El cable de CLK baja recto
// desde la fila inferior, columna 3, del header del ADC.
IO_LOC "adc_clk" 26;
IO_PORT "adc_clk" IO_TYPE=LVCMOS33 DRIVE=8;

// --- ADC: BUS DE DATOS (12 bits, ordenado por columna física del ADC) ---
// La numeración del bus sigue la del ADC: bit 0 = D0 (LSB), bit 11 = D11 (MSB).
// En Fase 1 solo se usan los 8 MSBs ([11:4]); el resto queda como entrada
// declarada pero sin cargar lógica (alta impedancia eléctrica con pull-down).
IO_LOC "adc_data_raw[0]"  25;    // D0  — col 3 sup — usado en F3
IO_LOC "adc_data_raw[2]"  27;    // D2  — col 4 sup — usado en F2
IO_LOC "adc_data_raw[1]"  28;    // D1  — col 4 inf — usado en F3
IO_LOC "adc_data_raw[4]"  29;    // D4  — col 5 sup — F1 (LSB del modo 8-bit)
IO_LOC "adc_data_raw[3]"  30;    // D3  — col 5 inf — usado en F2
IO_LOC "adc_data_raw[6]"  33;    // D6  — col 6 sup — F1
IO_LOC "adc_data_raw[5]"  34;    // D5  — col 6 inf — F1
IO_LOC "adc_data_raw[8]"  40;    // D8  — col 7 sup — F1
IO_LOC "adc_data_raw[7]"  35;    // D7  — col 7 inf — F1
IO_LOC "adc_data_raw[10]" 41;    // D10 — col 8 sup — F1
IO_LOC "adc_data_raw[9]"  42;    // D9  — col 8 inf — F1
IO_LOC "adc_data_raw[11]" 53;    // D11 — col 9 inf — F1 (MSB)

// --- ADC: OTR (Out-of-Range) ---
// Flag del AD9226 que se pone HIGH cuando la entrada analógica excede el rango
// de fondo de escala. Declarado y físicamente cableado, pero sin uso en HDL
// en Fase 1. Uso futuro propuesto: marcar ráfagas saturadas para descartarlas
// del signal averaging en el lado Python.
IO_LOC "adc_otr" 51;             // OTR — col 9 sup
IO_PORT "adc_otr" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- CONFIGURACIÓN ELÉCTRICA DEL BUS ADC ---
IO_PORT "adc_data_raw[11]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[10]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[9]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[8]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[7]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[6]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[5]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[4]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[3]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[2]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[1]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "adc_data_raw[0]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- LED DE ESTADO ---
// LED activo-bajo en Tang Nano 9K: pin LOW = LED encendido.
// El módulo top asigna led_busy = LOW cuando state != IDLE.
IO_LOC "led_busy" 10;
IO_PORT "led_busy" IO_TYPE=LVCMOS18;

// LED de trigger (etapa 5)
IO_LOC "led_trig" 11;
IO_PORT "led_trig" IO_TYPE=LVCMOS18;
